  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "rbush": "^4.0.1"
  },
  "peerDependencies": {
    "three": ">=0.167.0"
  },
  "license": "Apache-2.0"
}
